{
  "schema_version": "1.0",
  "name": "bai-shopping-brain-v0.1",
  "stage": "open-base-sft",
  "base_model": "Qwen/Qwen3-1.7B",
  "base_license": "Apache-2.0",
  "method": "qlora_sft",
  "seed": 42,
  "max_seq_length": 2048,
  "epochs": 3,
  "learning_rate": 0.0002,
  "micro_batch_size": 2,
  "gradient_accumulation_steps": 16,
  "lora": {
    "r": 32,
    "alpha": 64,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "data": {
    "language": "ru",
    "minimum_examples": 500,
    "require_review_status": "approved",
    "require_training_allowed_source": true,
    "structured_output_only": true
  },
  "runtime": {
    "external_api_required": false,
    "teacher_required_in_production": false
  }
}
